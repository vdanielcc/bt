+// The caller holds the event lock and commits the move and repricing together.
+public sealed class CompetitorCategoryMoveService(BteV1Context db)
+{
+    public async Task MoveAsync(int competitorId, MoveCompetitorCategoryDto request, int? actor, CancellationToken ct = default)
+    {
+        var competitor = await db.Competitors.SingleOrDefaultAsync(c => c.Id == competitorId && c.EventId == request.EventId, ct)
+            ?? throw new FixtureException(404, "Competidor no encontrado en el evento.");
+        var entries = await db.CategoryCompetitors.Where(c => c.CompetitorId == competitorId && c.EventId == request.EventId).ToListAsync(ct);
+        var source = entries.SingleOrDefault(c => c.CategoryId == request.SourceCategoryId)
+            ?? throw new FixtureException(409, "El competidor ya no está inscrito en la categoría de origen.");
+        if (request.TargetCategoryId <= 0 || entries.Any(c => c.CategoryId == request.TargetCategoryId))
+            throw new FixtureException(409, "El competidor ya está inscrito en la categoría de destino o el destino no es válido.");
+        var target = await db.Categories.SingleOrDefaultAsync(c => c.Id == request.TargetCategoryId, ct);
+        var origin = await db.Categories.SingleAsync(c => c.Id == request.SourceCategoryId, ct);
+        if (target == null || target.ModalityId != origin.ModalityId ||
+            !await db.CategoryEvents.AnyAsync(c => c.EventId == request.EventId && c.CategoryId == target.Id, ct))
+            throw new FixtureException(422, "Selecciona una categoría del evento y de la misma modalidad.");
+        var ids = entries.Select(c => c.CategoryId == request.SourceCategoryId ? target.Id : c.CategoryId).ToArray();
+        var error = await Event60EnrollmentPolicy.ValidateAsync(db, request.EventId, ids, competitor.TeamId.HasValue);
+        if (error != null) throw new FixtureException(422, error);
+
+        db.CategoryCompetitors.Remove(source);
+        db.CategoryCompetitors.Add(new CategoryCompetitor { EventId = request.EventId, CompetitorId = competitorId, CategoryId = target.Id });
+        var engine = new EventPricingService(db);
+        competitor.TicketFactor = await engine.BillableCategoryCountAsync(ids, ct);
+        await db.SaveChangesAsync(ct);
+
+        // Reprice affected batch entries without changing transfers or their review status.
+        var items = await db.TariffPaymentBatchItems.Include(i => i.Batch)
+            .Where(i => i.CompetitorId == competitorId && i.Batch.EventId == request.EventId && !i.Batch.IsCancelled).ToListAsync(ct);
+        var operation = Guid.NewGuid().ToString("N");
+        foreach (var group in items.GroupBy(i => i.BatchId))
+        {
+            var batch = group.First().Batch;
+            var before = new { batch.Total, batch.Version, Items = group.Select(i => new { i.Id, i.Amount, i.CalculationJson }).ToArray() };
+            foreach (var item in group)
+            {
+                var previous = JsonSerializer.Deserialize<EnrollmentPriceResultDto>(item.CalculationJson, EventPricingService.JsonOptions)!;
+                var selection = previous.Categories.Select(c => c.CategoryId == request.SourceCategoryId ? target.Id : c.CategoryId).Distinct().ToArray();
+                if (!previous.Categories.Any(c => c.CategoryId == request.SourceCategoryId)) continue;
+                var price = await PriceAsync(competitor, selection, batch.Period, ct);
+                if (price.Status != "CALCULATED") throw new FixtureException(422, price.Warning ?? "Configura la tarifa de destino.");
+                batch.Total += price.TotalAmount - item.Amount;
+                item.Amount = price.TotalAmount;
+                item.CalculationJson = JsonSerializer.Serialize(price, EventPricingService.JsonOptions);
+            }
+            if (batch.Total < 0 || batch.Total > 99999999.99m || decimal.Truncate(batch.Total) != batch.Total)
+                throw new FixtureException(422, "El lote debe tener un importe válido en pesos enteros.");
+            batch.Version++;
+            EventPaymentLedger.Audit(db, request.EventId, competitor.AcademyId, actor, batch.Id, "", "CATEGORY_MOVE",
+                "Movimiento de categoría y recálculo de cobros", operation + ":" + batch.Id,
+                new { request.SourceCategoryId, request.TargetCategoryId, Before = before, After = new { batch.Total, batch.Version } });
+        }
+        await db.SaveChangesAsync(ct);
+        var current = await engine.CalculateAsync(request.EventId, competitorId, ids, ct);
+        if (current.Status != "CALCULATED")
+            current = await engine.PreviewAsync(request.EventId, ids, competitor.TeamId.HasValue ? "EQUIPO" : "INDIVIDUAL", ct);
+        // Legacy locked prices must also reflect the new selection.
+        var locked = await db.RegistrationPricings.SingleOrDefaultAsync(p => p.EventId == request.EventId && p.CompetitorId == competitorId, ct);
+        if (locked != null)
+        {
+            current = await PriceAsync(competitor, ids, locked.PricingPeriod, ct);
+            locked.AppliedValue = checked((int)current.TotalAmount);
+            locked.UpdatedAt = DateTime.UtcNow;
+        }
+        var charge = await engine.SaveCombinationCalculationAsync(request.EventId, competitorId,
+            "Movimiento de categoría y recálculo de cobros", actor, operation, true, ct, current);
+        foreach (var item in items) item.ChargeId = charge.Id;
+        EventPaymentLedger.Audit(db, request.EventId, competitor.AcademyId, actor, null, "", "CATEGORY_MOVE",
+            "Movimiento de categoría y recálculo de cobros", operation,
+            new { competitorId, request.SourceCategoryId, request.TargetCategoryId, charge.Id, charge.TotalAmount });
+        await db.SaveChangesAsync(ct);
+    }
+
+    private async Task<EnrollmentPriceResultDto> PriceAsync(Competitor competitor, int[] ids, string period, CancellationToken ct)
+    {
+        var categories = await db.Categories.Where(c => ids.Contains(c.Id)).ToListAsync(ct);
+        var names = await db.Modalities.ToDictionaryAsync(m => m.Id, m => m.Name, ct);
+        var options = categories.Select(c => new PricingCategoryOption(c.Id, c.Name, c.ModalityId, names.GetValueOrDefault(c.ModalityId))).ToList();
+        var rule = await db.EventPriceRules.Include(r => r.CalculationType).Include(r => r.Categories)
+            .Include(r => r.Groups).Include(r => r.Modalities).SingleOrDefaultAsync(r => r.EventId == competitor.EventId && r.IsActive, ct);
+        var type = competitor.TeamId.HasValue ? "EQUIPO" : "INDIVIDUAL";
+        EnrollmentPriceResultDto price;
+        if (rule?.CalculationType.Code == "BY_COMBINATION")
+            price = EventPricingService.EvaluateCombination(rule, options, type, period == "PRESALE");
+        else if (rule != null) price = EventPricingService.Evaluate(rule, options);
+        else
+        {
+            var ev = await db.Events.SingleAsync(e => e.Id == competitor.EventId, ct);
+            var deadline = EventPricingService.PresaleDeadlineUtc(ev.PresaleEndAt);
+            var date = period == "PRESALE" && deadline.HasValue ? deadline.Value.AddTicks(-1)
+                : deadline.HasValue && deadline.Value > DateTime.UtcNow ? deadline.Value : DateTime.UtcNow;
+            price = EventPricingService.EvaluateLegacy(ev, options,
+                await db.TicketFactors.Where(f => f.EventId == ev.Id).ToListAsync(ct), type, date);
+        }
+        price.CompetitorId = competitor.Id;
+        return price;
+    }
+}
