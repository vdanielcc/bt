+        public async Task<IActionResult> MoveCategory(int competitorId, MoveCompetitorCategoryDto dto)
+        {
+            if (!await EventOrganizerAccess.CanManageAsync(_context, new AcademyAuthorizationService(_context), User, dto.EventId))
