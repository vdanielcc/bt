+            await using var transaction = _context.Database.IsRelational()
+                ? await _context.Database.BeginTransactionAsync() : null;
+            var ev = await LoadEnrollmentEvent(dto.EventId);
+            if (ev == null) return NotFound();
+            await new EnrollmentDeadlineService(_context).EnsureOpenAsync(ev, User, null, "move-category", new { competitorId, dto.SourceCategoryId, dto.TargetCategoryId });
+            await new CompetitorCategoryMoveService(_context).MoveAsync(competitorId, dto,
+                GradingAuthorizationService.UserId(User));
+            if (transaction != null) await transaction.CommitAsync();
+            return Ok(ApiResponder.Ok(new { CompetitorId = competitorId }, "Categoría actualizada y cobros recalculados."));
+        }
